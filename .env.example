# Server Port
PORT=3000

# MongoDB Connection URI (Local or MongoDB Atlas) - required
MONGO_URI=mongodb://localhost:27017/nabhacare

# JWT Authentication Secret - required
JWT_SECRET=nabha-care-secret-key-2026

# Comma-separated list of allowed frontend origins (Express CORS + Socket.IO)
CORS_ORIGIN=http://localhost:5173

# TextBee SMS gateway (used for the offline/SMS appointment booking flow)
TEXTBEE_API_KEY=
TEXTBEE_DEVICE_ID=
