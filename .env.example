# Server Port
PORT=3000

# MongoDB Connection URI (Local or MongoDB Atlas) - required
MONGO_URI=mongodb://localhost:27017/nabhacare

# JWT Authentication Secret - required
JWT_SECRET=nabha-care-secret-key-2026

# Comma-separated list of allowed frontend origins (Express CORS + Socket.IO)
CORS_ORIGIN=http://localhost:5173

# TextBee SMS gateway (used for the offline/SMS appointment booking flow)
TEXTBEE_API_KEY=
TEXTBEE_DEVICE_ID=

# Twilio (used for the automated ambulance/cab dispatch calling drivers by
# voice + SMS in services/twilioService.js). Optional: the dispatch engine
# works fully via in-app accept/reject without these, and only skips the
# actual phone call/SMS step when they're unset.
# - TWILIO_ACCOUNT_SID / TWILIO_AUTH_TOKEN: from your Twilio Console.
# - TWILIO_PHONE_NUMBER: a Twilio number with Voice + SMS capability, E.164 format (e.g. +1415XXXXXXX).
# - PUBLIC_BASE_URL: a publicly reachable URL for this server, so Twilio can call back into
#   /api/twilio/voice/*  /api/twilio/sms/*. In local dev, run `ngrok http 3000` and paste
#   the https://*.ngrok-free.app URL here (no trailing slash).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
PUBLIC_BASE_URL=

# How long (seconds) to ring one driver before the dispatch engine cascades to the next.
DISPATCH_TIMEOUT_SECONDS=30
