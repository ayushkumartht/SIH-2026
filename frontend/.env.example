# Backend API base URL (defaults to http://localhost:3000 if unset)
VITE_API_URL=http://localhost:3000

# Optional TURN relay for WebRTC video/audio calls (LiveConsultation.jsx).
# Without this, calls only use STUN, which fails to connect whenever both
# participants are on different networks behind a NAT/firewall (mobile data,
# most office/campus WiFi) — the call will silently show a blank video with
# no error until this is set. Free/paid TURN options: Twilio's Network
# Traversal Service (reuses the same Twilio account as ambulance dispatch),
# Xirsys, Metered, or self-hosted coturn.
VITE_TURN_URL=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=
